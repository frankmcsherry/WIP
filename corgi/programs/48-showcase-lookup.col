# SHOWCASE — a table lookup with a default. The table is [0,1,4,9,16,25] (squares); the queries
# [0..n+2) run two past the end. Plain `gather` reads 0 past the end, which is the default wanted
# here. With another default, `try_get` checks each query: a hit lands in lane 0 with its value, a
# miss in lane 1, and the `match` supplies -1 for it. The table is captured by reference, so each
# query carries a row number rather than a copy of the table.
# n = 6
# = (List ends=[8] <[0, 1, 4, 9, 16, 25, 0, 0]>, List ends=[8] <[0, 1, 4, 9, 16, 25, -1, -1]>)
let table = input iota map (x -> (x, x) mul) in
let queries = (input, 2) add iota in
((queries, table) gather,
 (table ref, queries) cap_list map ((t, q) -> (q, t) try_get match (0 (v -> v), 1 (_ -> -1))))
