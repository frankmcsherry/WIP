# SHOWCASE — min, max, and sum in ONE pass via a heterogeneous `fold`. The accumulator B = (Int, Int,
# Int) is a different shape than the element A = Int, as the lambda's pattern says; the body folds
# all three monoids at once (min/max from the SIMD grid, add). Over [0,1,2,3,0,1,2,3]: min 0, max 3,
# sum 12. One traversal, three aggregates — the heterogeneous accumulator is what makes it a single
# fold instead of three.
# n = 8
# = ([0], [3], [12])
let xs = input iota map (x -> x and 3) in
let seed = (999, 0, 0) in
(seed, xs) fold ((acc : (int, int, int), x : int) -> ((acc.0, x) min, (acc.1, x) max, (acc.2, x) add))
