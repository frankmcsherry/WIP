# the embellishment law for filter: filtering (mask, x) pairs equals its kernel expansion —
# branch each element on its mask bit, unweave the sum column, and keep lane 1. The fused op earns
# its keep as one mask-driven pass; this law says it adds no expressive power.
# n = 8
# = [1]
let data = input iota in
let fused = data map (x -> (x and 1, x)) filter in
let kernel = data map (x -> (x, x and 1) branch 2) unweave .2 in
(fused, kernel) eq
