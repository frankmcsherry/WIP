# typed FLOAT arithmetic, reached by suffix (`div_f32`, `neg_f32`). Floats enter via `to_f32` (an
# unsigned int -> the f32 of the same value, total-order encoded), which is also how a literal such as
# `1.5f32` is laid down. Two checks: 6/4 = 3/2 = 1.5 (IEEE division), and -1.0 < +1.0
# under the TOTAL order (the kind-blind comparator on the swizzled bits). Division is total: x/0 -> inf,
# never a panic. Float order/equality is total, NOT IEEE (NaN orderable, -0 != +0) — see NOTES.
# n = 1
# = [1]
let half3 = (3u32 to_f32, 2u32 to_f32) div_f32 in
let half6 = (6u32 to_f32, 4u32 to_f32) div_f32 in
((half3, half6) eq, (1u32 to_f32 neg_f32, 1u32 to_f32) lt) mul
