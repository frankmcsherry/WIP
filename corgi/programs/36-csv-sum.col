# sum a CSV row, defaulting the unparseable: `parse_u64` is total — Sum{Ok: U64 | Err} — so the
# malformed "x" is a counted Err row, not a panic. `map_variant Err` defaults it to `0u64` (one
# per row of the lane), the now-homogeneous sum unwraps to U64, and the row reduces:
# 1 + 20 + 0 + 4000.
# n = 1
# = [4021]
enum Parsed = Ok | Err in
"1,20,x,4000" split ","
map (w -> w parse_u64 map_variant Err (e -> 0u64) unwrap)
fold_add
