# Jaccard similarity of two sets: |A ∩ B| / |A ∪ B|. Input `(a, b)`, two `List<Int>` that may hold
# duplicates. Output a `Float`; two empty sets are identical, 1.0.
#
# Deduplicate both, count the elements of A that B contains (an equal range of length one), and
# the union is what is left of both.
let (a, b) = input in
let sa = a dedup in
let sb = b dedup in
let inter = (sa, sb) find map ((lo, hi) -> (hi, lo) sub) fold_add in
let union = ((sa len, sb len) add, inter) sub in
((union, 0) eq, 1.0, (inter to_float, union to_float) div) select
