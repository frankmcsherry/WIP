# Jaro-Winkler similarity over bytes, as `strsim::jaro_winkler` computes it on ASCII.
# Input `(s1, s2)`, two `List<Int>` of bytes. Output a `Float`.
let (s1, s2) = input in
let (l1, l2) = (s1 len, s2 len) in
# The match window: max(l1, l2) / 2 - 1, saturating at zero.
let d = ((((l1, l2) max shr 1), 1) max, 1) sub in
# Number the bytes: s1 as (i, c), s2 as (j, c, matched).
let s1x = ((0, s1) foldscan ((i, c) -> ((i, 1) add, (i, c)))) .1 in
let s2x = ((0, s2) foldscan ((j, c) -> ((j, 1) add, (j, c, 0)))) .1 in
# The greedy match: for each byte of s1, take the first unmatched equal byte of s2 in the window.
let matching = ((d, s2x), s1x) foldscan (((d, st), (i, c)) ->
    let cand = ((d, i, c), st) cap_list map (((d, i, c), (j, ch, m)) ->
        let ok = (((ch, c) eq, (m, 0) eq) mul, ((i, (j, d) add) le, (j, (i, d) add) le) mul) mul in
        (ok, j, 1000000000) select) in
    let jm = ((cand len, 0) eq, 1000000000, cand fold_min) select in
    let st2 = (jm, st) cap_list map ((jm, (j, ch, m)) -> (j, ch, (m, (j, jm) eq) max)) in
    let same = ((i, c), st) cap_list map (((i, c), (j, ch, _)) -> ((i, j) eq, (c, ch) eq) mul) fold_any in
    ((d, st2), ((jm, 1000000000) lt, same, (i, 4) lt, c))) in
let ((_, s2m), per1) = matching in
let m = per1 map ((hit, _, _, _) -> hit) fold_add in
# Transpositions: rank the matched bytes of each string, then compare equal ranks.
let rank2 = ((0, s2m) foldscan ((k, (_, ch, mm)) -> let k2 = (k, mm) add in (k2, (ch, mm, k2)))) .1 in
let rank1 = ((0, per1) foldscan ((k, (hit, _, _, c)) -> let k2 = (k, hit) add in (k2, (c, hit, k2)))) .1 in
let t2 = (rank2, rank1) cap_list map ((rank2, (c, hit, k)) ->
    let mis = ((c, k), rank2) cap_list map (((c, k), (ch, mm, k2)) -> ((mm, (k2, k) eq) mul, (ch, c) ne) mul) fold_any in
    (mis, hit) mul) fold_add in
let t = t2 shr 1 in
# The common prefix, up to four bytes.
let prefix = (((0, 1), per1) fold (((p, alive), (_, same, lt4, _)) ->
    let a2 = ((alive, same) mul, lt4) mul in
    ((p, a2) add, a2))) .0 in
let fm = m to_float in
let jaro = ((((fm, l1 to_float) div, (fm, l2 to_float) div) add, ((fm, t to_float) sub, fm) div) add, 3.0) div in
let jaro = ((m, 0) eq, 0.0, jaro) select in
let sim = (((l1, l2) add, 0) eq, 1.0, jaro) select in
let jw = (sim, ((0.1, prefix to_float) mul, (1.0, sim) sub) mul) add in
((0.7, sim) lt, jw, sim) select
