# Days since 1970-01-01 of a proleptic Gregorian date, by Howard Hinnant's `days_from_civil`, and
# its weekday (0 = Sunday). Input `(year, month, day)`, three `U64` columns (years 1900-2100).
# Output `(days, weekday)`: days an `I64` (negative before 1970), weekday a `U64`.
let (y, m, d) = input in
# The year starts in March, so January and February belong to the year before.
let y = (y, (m, 2u64) le) sub in
let era = (y, 400u64) div_u64 in
let yoe = (y, (era, 400u64) mul) sub in
# Months from March: March is 0, February is 11.
let mp = ((m, 2u64) gt, (m, 3u64) sub, (m, 9u64) add) select in
let doy = ((((153u64, mp) mul, 2u64) add, 5u64) div_u64, (d, 1u64) sub) add in
let doe = ((((yoe, 365u64) mul, (yoe, 4u64) div_u64) add, (yoe, 100u64) div_u64) sub, doy) add in
# Days since 0000-03-01, never negative for these years; 1970-01-01 is day 719468.
let n = ((era, 146097u64) mul, doe) add in
let days = (n signed, 719468i64) sub_i64 in
# 0000-03-01 was a Wednesday, so day n is weekday (n + 3) mod 7.
let weekday = ((n, 3u64) add, 7u64) rem in
(days, weekday)
