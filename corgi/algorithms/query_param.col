# Look up one parameter of a URL query string: in "a=1&b=two&c" the key "b" has the value "two".
# Pairs are separated by '&', a pair's key from its value by '='; a pair without '=' has an empty
# value; the first pair with the key wins. Input `(query, key)`, two `List<Int>` of bytes. Output
# `Sum{List<Int> | ()}`: the value, or () when no pair has the key.
let (q, key) = input in
let pairs = q split "&" map (p ->
    let parts = p split "=" in
    ((0, parts) get, (1, parts) get)) in
let found = (key, pairs) cap_list map ((key, (k, v)) -> ((k, key) eq, v)) filter in
(0, found) try_get
