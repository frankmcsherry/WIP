# mode counted without building value lists: sort, mark where each run of equal values starts,
# and cut the runs; a run's length is its value's count.
let s = input sort in
let starts = s adjacent in
let values = (starts, s) zip filter in
let counts = (starts, s) zip cut map (r -> r len) in
let top = counts fold_max in
# Runs come out in value order, so the first run with the top count is the smallest value.
let winners = (top, (values, counts) zip) cap_list map ((top, (v, c)) -> ((c, top) eq, v)) filter in
winners head
