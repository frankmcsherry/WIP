# Base64, as base64_encode.col, rewritten to avoid its two costs: the 64-byte alphabet (a literal
# inside `map`, so a copy of it per group) becomes arithmetic on the six-bit value, and the four
# characters of a group are made by one `map` over [0, 4) instead of three `append`s.
let n = input len in
let pad = ((3, (n, 3) rem) sub, 3) rem in
let zeros = pad iota map (_ -> 0) in
let text = (input, zeros) append chunk 3 map (g ->
    let a = (0, g) get in
    let b = (1, g) get in
    let c = (2, g) get in
    let v = (((a, 65536) mul, (b, 256) mul) add, c) add in
    (v, 4 iota) cap_list map ((v, j) ->
        # the j-th six bits of the group (shifts take constants, so pick among four), then the
        # character for that six-bit value.
        let s = ((j, 0) eq, v shr_b64 18, ((j, 1) eq, v shr_b64 12, ((j, 2) eq, v shr_b64 6, v) select) select) select and 63 in
        ((s, 26) lt, (s, 65) add, ((s, 52) lt, (s, 71) add, ((s, 62) lt, (s, 4) sub, ((s, 62) eq, 43, 47) select) select) select) select)) flatten .1 in
let cut = (text len, pad) sub in
(cut, (text len iota, text) zip) cap_list map ((cut, (k, ch)) -> ((k, cut) ge, 61, ch) select)
