# TPC-H Q6, in integers: revenue gained by removing small discounts in 1994 (cents x percent).
# sql: SELECT sum(l_extendedprice * l_discount) FROM lineitem WHERE l_shipdate >= 8766 AND l_shipdate < 9131
# sql:   AND l_discount BETWEEN 5 AND 7 AND l_quantity < 24
# columns: l_shipdate l_discount l_quantity l_extendedprice
# output: u
let (date, disc, qty, price) = input in
((date, disc) zip, (qty, price) zip) zip
    map (((d, k), (q, p)) ->
        let keep = ((((d, 8766u64) ge, (d, 9131u64) lt) mul, ((k, 5u64) ge, (k, 7u64) le) mul) mul, (q, 24u64) lt) mul in
        (keep, (p, k) mul))
    filter fold_add
    try match (0 (s -> s), 1 (_ -> 0u64))
