# q19 as an optimizer would leave it: the hash of each string literal folded to its constant.
# (Measures what constant folding recovers; same answer.)
# sql: SELECT sum(l_extendedprice * (100 - l_discount)) FROM lineitem, part WHERE p_partkey = l_partkey
# sql:   AND l_shipmode IN ('AIR', 'AIR REG') AND l_shipinstruct = 'DELIVER IN PERSON' AND (
# sql:   (p_brand = 'Brand#12' AND p_container IN ('SM CASE', 'SM BOX', 'SM PACK', 'SM PKG')
# sql:     AND l_quantity >= 1 AND l_quantity <= 11 AND p_size BETWEEN 1 AND 5)
# sql:   OR (p_brand = 'Brand#23' AND p_container IN ('MED BAG', 'MED BOX', 'MED PKG', 'MED PACK')
# sql:     AND l_quantity >= 10 AND l_quantity <= 20 AND p_size BETWEEN 1 AND 10)
# sql:   OR (p_brand = 'Brand#34' AND p_container IN ('LG CASE', 'LG BOX', 'LG PACK', 'LG PKG')
# sql:     AND l_quantity >= 20 AND l_quantity <= 30 AND p_size BETWEEN 1 AND 15))
# columns: p_partkey p_brand p_container p_size l_partkey l_quantity l_shipmode l_shipinstruct l_extendedprice l_discount
# output: u
let (pkey, brand, cont, size, lpart, qty, mode, instr, price, disc) = input in
# Each part's group: 1, 2 or 3 when its brand, container and size fit one, else 0; sorted by key.
let parts = ((pkey, brand) zip, (cont, size) zip) zip map (((k, b), (c, s)) ->
    let bh = b hash in
    let ch = c hash in
    let g1 = (((bh, 5136627175545551744u64) eq, (((ch, 374979569343216244u64) eq, (ch, 17596264379545495876u64) eq) max,
        ((ch, 2373981812220464414u64) eq, (ch, 5836966922244107823u64) eq) max) max) mul, ((s, 1u64) ge, (s, 5u64) le) mul) mul in
    let g2 = (((bh, 11254724662393005777u64) eq, (((ch, 13643528128180761743u64) eq, (ch, 10046015249566378694u64) eq) max,
        ((ch, 11196886018461526845u64) eq, (ch, 15138173392433026312u64) eq) max) max) mul, ((s, 1u64) ge, (s, 10u64) le) mul) mul in
    let g3 = (((bh, 1931434959923757408u64) eq, (((ch, 12002432913231412582u64) eq, (ch, 10848764025060747566u64) eq) max,
        ((ch, 3991042364367172572u64) eq, (ch, 3254828290428745813u64) eq) max) max) mul, ((s, 1u64) ge, (s, 15u64) le) mul) mul in
    (k, ((g1, (2u64, g2) mul) add, (3u64, g3) mul) add)) sort in
# Line items shipped by air and delivered in person: (part key, quantity, revenue).
let lines = (((lpart, qty) zip, (mode, instr) zip) zip, (price, disc) zip) zip
    map ((((k, q), (m, i)), (p, d)) ->
        let mh = m hash in
        let air = ((mh, 3777252998545058029u64) eq, (mh, 17403949804841612806u64) eq) max in
        ((air, (i hash, 10226176562333648u64) eq) mul, (k, q, (p, (100u64, d) sub) mul)))
    filter in
# Each line item's part group, by looking its part up; the quantity must fit the group.
let at = (lines map ((k, _, _) -> k), parts map ((k, _) -> k)) find in
let group = (at map ((lo, _) -> lo), parts) gather map ((_, g) -> g) in
(group, lines) zip map ((g, (_, q, r)) ->
    let in1 = ((g, 1u64) eq, ((q, 1u64) ge, (q, 11u64) le) mul) mul in
    let in2 = ((g, 2u64) eq, ((q, 10u64) ge, (q, 20u64) le) mul) mul in
    let in3 = ((g, 3u64) eq, ((q, 20u64) ge, (q, 30u64) le) mul) mul in
    (((in1, in2) max, in3) max, r) mul) fold_add
    try match (0 (x -> x), 1 (_ -> 0u64))
