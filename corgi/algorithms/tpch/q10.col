# TPC-H Q10, in integers: the twenty customers with the most revenue lost to returns in 1993-Q4,
# with their nation. (The SQL's other customer columns are left out: they only ride along.)
# sql: SELECT c_custkey, sum(l_extendedprice * (100 - l_discount)) AS revenue, n_name
# sql:   FROM customer, orders, lineitem, nation WHERE c_custkey = o_custkey AND l_orderkey = o_orderkey
# sql:   AND o_orderdate >= 8674 AND o_orderdate < 8766 AND l_returnflag = 'R' AND c_nationkey = n_nationkey
# sql:   GROUP BY c_custkey, n_name ORDER BY revenue DESC, c_custkey LIMIT 20
# columns: c_custkey c_nationkey n_nationkey n_name o_orderkey o_custkey o_orderdate l_orderkey l_returnflag l_extendedprice l_discount
# output: [u,u,s]
let (ckey, cnat, nkey, nname, okey, ocust, odate, lkey, lrf, price, disc) = input in
# Orders from 1993-Q4 (key, customer), sorted by key.
let orders = ((okey, ocust) zip, odate) zip
    map (((k, c), dt) -> (((dt, 8674) ge, (dt, 8766) lt) min, (k, c))) filter sort in
# Returned line items, each looked up in those orders: revenue per customer.
let lines = ((lkey, lrf) zip, (price, disc) zip) zip
    map (((k, f), (p, d)) -> ((f, "R") eq, (k, (p, (100, d) sub) mul))) filter in
let at = (lines map ((k, _) -> k), orders map ((k, _) -> k)) find in
let matched = (at, lines) zip map (((lo, hi), (_, r)) -> ((hi, lo) gt, (lo, r))) filter in
let custs = (matched map ((lo, _) -> lo), orders) gather map ((_, c) -> c) in
let per = (custs, matched map ((_, r) -> r)) zip group
    map ((c, rs) -> let r = rs fold_add in (r neg, c, r)) sort_limit 20 in
let top = per in
# The top customers' nation names: customer -> nation key -> name.
let cs = (ckey, cnat) zip sort in
let ns = (nkey, nname) zip sort in
let cat = (top map ((_, c, _) -> c), cs map ((k, _) -> k)) find in
let natk = (cat map ((lo, _) -> lo), cs) gather map ((_, n) -> n) in
let nat = (natk, ns map ((k, _) -> k)) find in
let names = (nat map ((lo, _) -> lo), ns) gather map ((_, name) -> name) in
(top, names) zip map (((_, c, r), name) -> (c, r, name))
    try match (0 (x -> x), 1 (_ -> 0 iota map (z -> (z, z, ""))))
