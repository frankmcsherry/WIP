# Are the brackets of a byte string balanced? Three kinds, () [] {}, nest; other bytes are ignored.
# Input a `List<Int>` of bytes per row. Output 1 if balanced, else 0.
#
# The textbook stack machine: walk the bytes keeping a stack of open brackets. An opener is
# pushed; a closer must match the opener on top, which it pops; anything else leaves the stack
# alone. Balanced when no closer failed and the stack ends empty.
let (ok, stack) = ((1, ""), input) fold (((ok, stack), c) ->
    let open = (((c, 40) eq, (c, 91) eq) max, (c, 123) eq) max in
    let close = (((c, 41) eq, (c, 93) eq) max, (c, 125) eq) max in
    # the opener a closer needs: ( for ), [ for ], { for }
    let want = ((c, 41) eq, 40, ((c, 93) eq, 91, 123) select) select in
    let n = stack len in
    let top = (((n, 1) max, 1) sub, stack) get try match (0 (t -> t), 1 (_ -> 0)) in
    let matched = ((n, 0) gt, (top, want) eq) mul in
    # 0: push, 1: pop, 2: leave the stack as it is
    let action = (open, 0, (close, 1, 2) select) select in
    let stack2 = ((c, stack), action) branch 3 match (
        0 ((c, s) -> (s, c enlist) append),
        1 ((_, s) -> ((0, ((s len, 1) max, 1) sub) range, s) gather try match (0 (t -> t), 1 (_ -> ""))),
        2 ((_, s) -> s)) in
    ((ok, (close, matched, 1) select) mul, stack2)) in
(ok, (stack len, 0) eq) mul
