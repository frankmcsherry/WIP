# Base64 (RFC 4648, standard alphabet, '=' padding). Input a `List<Int>` of bytes. Output a
# `List<Int>` of text, four characters for every three bytes (a partial last group is padded with
# '=').
let n = input len in
# Pad with zero bytes to whole groups of three; remember how many, to write '=' for them.
let pad = ((3, (n, 3) rem) sub, 3) rem in
let zeros = pad iota map (_ -> 0) in
let text = (input, zeros) append chunk 3 map (g ->
    let a = (0, g) get in
    let b = (1, g) get in
    let c = (2, g) get in
    # Four six-bit values from the 24 bits.
    let s0 = a shr_b64 2 in
    let s1 = ((a and 3, 16) mul, b shr_b64 4) add in
    let s2 = ((b and 15, 4) mul, c shr_b64 6) add in
    let s3 = c and 63 in
    let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/" in
    (((s0, alphabet) get enlist, (s1, alphabet) get enlist) append,
     ((s2, alphabet) get enlist, (s3, alphabet) get enlist) append) append) flatten .1 in
# The characters made from padding become '='.
let cut = (text len, pad) sub in
(cut, (text len iota, text) zip) cap_list map ((cut, (k, ch)) -> ((k, cut) ge, 61, ch) select)
