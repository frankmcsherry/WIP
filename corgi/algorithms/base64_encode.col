# Base64 (RFC 4648, standard alphabet, '=' padding). Input `List<U8>` of bytes. Output `List<U8>`
# of text, four characters for every three bytes (a partial last group is padded with '=').
let n = input len in
# Pad with zero bytes to whole groups of three; remember how many, to write '=' for them.
let pad = ((3u64, (n, 3u64) rem) sub, 3u64) rem in
let zeros = pad iota map (_ -> 0u8) in
let text = (input, zeros) append chunk 3 map (g ->
    let a = (0u64, g) get cast 64 in
    let b = (1u64, g) get cast 64 in
    let c = (2u64, g) get cast 64 in
    # Four six-bit values from the 24 bits.
    let s0 = a shr 2 in
    let s1 = ((a and 3, 16u64) mul, b shr 4) add in
    let s2 = ((b and 15, 4u64) mul, c shr 6) add in
    let s3 = c and 63 in
    let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/" in
    (((s0, alphabet) get enlist, (s1, alphabet) get enlist) append,
     ((s2, alphabet) get enlist, (s3, alphabet) get enlist) append) append) flatten .1 in
# The characters made from padding become '='.
let cut = (text len, pad) sub in
(cut, (text len iota, text) zip) cap_list map ((cut, (k, ch)) -> ((k, cut) ge, 61u8, ch) select)
    try match (0 (t -> t), 1 (_ -> ""))
