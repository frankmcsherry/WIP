# The median (the lower one for an even count) and the 90th percentile (nearest rank) of each row's
# values. Input a `List<Int>`. Output `(median, p90)`, two `Int`s; an empty row gives `(0, 0)`.
let s = input sort in
let n = s len in
# The lower median is at (n - 1) / 2; nearest rank puts p90 at ceil(9n / 10) - 1.
let mid = ((n, 1) sub, 2) div in
let rank = ((((n, 9) mul, 9) add, 10) div, 1) sub in
let median = (mid, s) get in
let p90 = (rank, s) get in
(median, p90)
