# `kadane` by prefix sums, with no fold: the best run ending at i is P[i] minus the smallest of
# P[0] .. P[i - 1], where P[0] = 0 and P[i] = x[0] + .. + x[i - 1]. The rewrite of the max-plus
# recurrence cur = max(x, cur + x) into scans: a prefix sum, a running minimum, a difference and a
# maximum. Input and output as `kadane`.
let xs = input in
let p = xs scan_add in
# The smallest prefix before each position: P[0] = 0, then the running minimum, cut to n entries.
let before = ((xs len) iota, (0 enlist, p) append scan_min) gather in
let best = (p, before) zip map ((hi, lo) -> (hi, lo) sub) fold_max
    try match (0 (b -> b), 1 (_ -> 0)) in
((xs len, 0) eq, 0, best) select
