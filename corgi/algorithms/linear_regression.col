# Least-squares line through each row's points: slope and intercept. Input a `List<(x, y)>` of
# `Float`s. Output `(slope, intercept)`, two `Float`s. No points gives (0, 0); a vertical spread of
# zero (one point, or every x equal) gives slope 0 and the mean y.
let pts = input in
let n = pts len to_float in
# One pass for the four sums.
let (sx, sy, sxx, sxy) = ((0.0, 0.0, 0.0, 0.0), pts) fold (((sx, sy, sxx, sxy), (x, y)) ->
    ((sx, x) add, (sy, y) add, (sxx, (x, x) mul) add, (sxy, (x, y) mul) add)) in
let num = ((n, sxy) mul, (sx, sy) mul) sub in
let den = ((n, sxx) mul, (sx, sx) mul) sub in
let slope = ((den, 0.0) eq, 0.0, (num, den) div) select in
let intercept = ((sy, (slope, sx) mul) sub, n) div in
let empty = (pts len, 0) eq in
((empty, 0.0, slope) select, (empty, 0.0, intercept) select)
