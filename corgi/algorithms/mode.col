# The most frequent value of each row (the smallest of those tied). Input a `List<Int>`. Output an
# `Int`; an empty row gives 0.
let xs = input in
# Count each value: group by it, and count the rows in each group.
let counts = xs map (x -> (x, ())) group map ((v, rows) -> (v, rows len)) in
let top = counts map ((_, c) -> c) fold_max in
# Groups come out in value order, so the first group with the top count is the smallest value.
let winners = (top, counts) cap_list map ((top, (v, c)) -> ((c, top) eq, v)) filter in
winners head
