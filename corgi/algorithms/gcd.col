# Greatest common divisor of two non-negative `Int`s by Euclid's algorithm. Input `(a, b)`.
# Output an `Int` (gcd(0, 0) = 0). There is no loop that runs until done, so the steps are a fold
# over a fixed count: Euclid needs at most 93 steps for 64-bit values (Lamé), and a finished pair
# stays put.
let (a, b) = input in
let (g, _) = ((a, b), 93 iota) fold (((a, b), _) ->
    let done = (b, 0) eq in
    ((done, a, b) select, (done, 0, (a, b) rem) select)) in
g
