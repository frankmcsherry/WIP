# Q16: SELECT UserID, SearchPhrase, COUNT(*) FROM hits GROUP BY UserID, SearchPhrase ORDER BY COUNT(*) DESC LIMIT 10
# sql: SELECT UserID, SearchPhrase, COUNT(*) AS c FROM hits GROUP BY UserID, SearchPhrase
# sql:   ORDER BY c DESC, UserID, SearchPhrase LIMIT 10
# columns: UserID SearchPhrase
# output: [i,s,u]
let (user, phrase) = input in
let ranked = (user, phrase) zip map ((u, s) -> ((u, s), 1)) group
    map (((u, s), ones) -> (ones len neg, u, s)) sort_limit 10 in
ranked map ((d, u, s) -> (u, s, d neg))
