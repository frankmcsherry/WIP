# Q24: SELECT SearchPhrase FROM hits WHERE SearchPhrase <> '' ORDER BY EventTime LIMIT 10
# q24 carrying the phrases by reference: the filter and the sort move row numbers, and only the ten
# phrases kept are copied.
# sql: SELECT SearchPhrase FROM hits WHERE SearchPhrase <> '' ORDER BY EventTime, octet_length(SearchPhrase), SearchPhrase LIMIT 10
# columns: EventTime SearchPhrase
# output: [s]
let (time, phrase) = input in
let sorted = (time, phrase map (s -> s ref)) zip map ((t, s) -> ((s len, 0u64) gt, (t, s))) filter sort_limit 10 in
sorted map ((_, s) -> s clone)
    try match (0 (x -> x), 1 (_ -> 0u64 iota map (z -> "")))
