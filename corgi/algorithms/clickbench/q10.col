# Q10: SELECT MobilePhoneModel, COUNT(DISTINCT UserID) AS u FROM hits WHERE MobilePhoneModel <> '' GROUP BY MobilePhoneModel ORDER BY u DESC LIMIT 10
# sql: SELECT MobilePhoneModel, COUNT(DISTINCT UserID) AS u FROM hits WHERE MobilePhoneModel <> '' GROUP BY MobilePhoneModel
# sql:   ORDER BY u DESC, MobilePhoneModel LIMIT 10
# columns: MobilePhoneModel UserID
# output: [s,u]
let (key, user) = input in
let ranked = (key, user) zip map ((s, u) -> ((s len, 0u64) gt, (s, u))) filter group
    map ((s, us) -> ((18446744073709551615u64, us dedup len) sub, s)) sort_limit 10 in
ranked map ((d, s) -> (s, (18446744073709551615u64, d) sub))
    try match (0 (x -> x), 1 (_ -> 0u64 iota map (z -> ("", z))))
