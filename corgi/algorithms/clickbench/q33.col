# Q33: SELECT URL, COUNT(*) AS c FROM hits GROUP BY URL ORDER BY c DESC LIMIT 10
# sql: SELECT URL, COUNT(*) AS c FROM hits GROUP BY URL ORDER BY c DESC, URL LIMIT 10
# columns: URL
# output: [s,u]
let ranked = input map (u -> (u, 1u64)) group map ((u, ones) -> ((18446744073709551615u64, ones len) sub, u)) sort_limit 10 in
ranked map ((d, u) -> (u, (18446744073709551615u64, d) sub))
