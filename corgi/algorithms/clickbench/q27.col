# Q27: SELECT CounterID, AVG(STRLEN(URL)) AS l, COUNT(*) AS c FROM hits WHERE URL <> '' GROUP BY CounterID HAVING COUNT(*) > 100000 ORDER BY l DESC LIMIT 25
# sql: SELECT CounterID, AVG(octet_length(URL)) AS l, COUNT(*) AS c FROM hits WHERE URL <> '' GROUP BY CounterID
# sql:   HAVING COUNT(*) > 1000 ORDER BY l DESC, CounterID LIMIT 25
# columns: CounterID URL
# output: [u,f,u]
# HAVING scaled to 1/100 (one partition of the hundred). Sorting on the negated average puts the
# largest first.
let (counter, url) = input in
let ranked = (counter, url) zip map ((c, u) -> ((u len, 0) gt, (c, u len))) filter group
    map ((c, ls) -> let n = ls len in ((n, 1000) gt, (c, (ls fold_add to_float, n to_float) div, n))) filter
    map ((c, l, n) -> (l neg, c, l, n)) sort_limit 25 in
ranked map ((_, c, l, n) -> (c, l, n))
