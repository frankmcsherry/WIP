# Q21: SELECT SearchPhrase, MIN(URL), COUNT(*) AS c FROM hits WHERE URL LIKE '%google%' AND SearchPhrase <> '' GROUP BY SearchPhrase ORDER BY c DESC LIMIT 10
# The variant with `sort_limit`: sorting only what can reach the limit.
# sql: SELECT SearchPhrase, arg_min(URL, {'l': octet_length(URL), 'u': URL}), COUNT(*) AS c FROM hits
# sql:   WHERE decode(URL) LIKE '%google%' AND SearchPhrase <> '' GROUP BY SearchPhrase
# sql:   ORDER BY c DESC, octet_length(SearchPhrase), SearchPhrase LIMIT 10
# columns: SearchPhrase URL
# output: [s,s,u]
# MIN(URL) is the first in corgi's string order (shorter first, then bytes), so the SQL takes the
# same minimum.
# corgi has no substring search: a string contains "google" when, split at "e" (its last byte, which
# occurs once in it), some piece other than the last ends with "googl" (its last bytes read with
# gather_try, since a piece may be shorter).
let (phrase, url) = input in
let google = url map (u ->
    let pieces = u split "e" in
    let n = pieces len in
    let ends = pieces map (p ->
        let m = p len in
        let long = (m, 5u64) ge in
        let lo = (long, (m, 5u64) sub, 0u64) select in
        let tail = ((lo, (lo, 5u64) add) range, p) gather_try map (b -> b match (0 (x -> x), 1 (_ -> 0u8))) in
        (long, (tail, "googl") zip map ((a, c) -> (a, c) eq) fold_all) mul) in
    (n, (n iota, ends) zip) cap_list map ((n, (i, e)) -> (((i, 1u64) add, n) lt, e) mul) fold_any) in
let ranked = (phrase, (url, google) zip) zip map ((s, (u, g)) -> (((s len, 0u64) gt, g) mul, (s, u))) filter group
    map ((s, us) -> ((18446744073709551615u64, us len) sub, s, us sort head)) sort_limit 10 in
ranked map ((d, s, u) -> (s, u, (18446744073709551615u64, d) sub))
    try match (0 (x -> x), 1 (_ -> 0u64 iota map (z -> ("", "", z))))
