# Q31: SELECT WatchID, ClientIP, COUNT(*) AS c, SUM(IsRefresh), AVG(ResolutionWidth) FROM hits WHERE SearchPhrase <> '' GROUP BY WatchID, ClientIP ORDER BY c DESC LIMIT 10
# sql: SELECT WatchID, ClientIP, COUNT(*) AS c, SUM(IsRefresh), AVG(ResolutionWidth) FROM hits WHERE SearchPhrase <> '' 
# sql:   GROUP BY WatchID, ClientIP ORDER BY c DESC, WatchID, ClientIP LIMIT 10
# columns: WatchID ClientIP IsRefresh ResolutionWidth SearchPhrase
# output: [i,i,u,u,f]
let (watchid, ip, refresh, width, phrase) = input in
let rows = (watchid, (ip, (refresh, (width, phrase) zip) zip) zip) zip
    map ((e, (i, (r, (w, s)))) -> ((s len, 0u64) gt, ((e, i), (r, w)))) filter in
let ranked = rows group map (((e, i), vs) -> let n = vs len in
    ((18446744073709551615u64, n) sub, e, i, n, vs map ((r, _) -> r) fold_add, (vs map ((_, w) -> w) fold_add to_f64, n to_f64) div_f64)) sort in
((0u64, ((ranked len, 10u64) min)) range, ranked) gather
    try match (0 (top -> top map ((_, e, i, n, r, w) -> (e, i, n, r, w))), 1 (_ -> 0u64 iota map (z -> (z, z, z, z, 0f64))))
