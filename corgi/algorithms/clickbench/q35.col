# Q35: SELECT ClientIP, ClientIP - 1, ClientIP - 2, ClientIP - 3, COUNT(*) AS c FROM hits GROUP BY ClientIP, ClientIP - 1, ClientIP - 2, ClientIP - 3 ORDER BY c DESC LIMIT 10
# sql: SELECT ClientIP, ClientIP - 1, ClientIP - 2, ClientIP - 3, COUNT(*) AS c FROM hits
# sql:   GROUP BY ClientIP, ClientIP - 1, ClientIP - 2, ClientIP - 3 ORDER BY c DESC, ClientIP LIMIT 10
# columns: ClientIP
# output: [i,i,i,i,u]
# Written as the SQL is: grouped on all four expressions.
let ranked = input map (i -> ((i, (i, 1) sub, (i, 2) sub, (i, 3) sub), 1)) group
    map (((a, b, c, d), ones) -> (ones len neg, a, b, c, d)) sort_limit 10 in
ranked map ((x, a, b, c, d) -> (a, b, c, d, x neg))
