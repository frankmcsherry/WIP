# Q12: SELECT SearchPhrase, COUNT(*) AS c FROM hits WHERE SearchPhrase <> '' GROUP BY SearchPhrase ORDER BY c DESC LIMIT 10
# The variant with `sort_limit`: sorting only what can reach the limit.
# sql: SELECT SearchPhrase, COUNT(*) AS c FROM hits WHERE SearchPhrase <> '' GROUP BY SearchPhrase
# sql:   ORDER BY c DESC, octet_length(SearchPhrase), SearchPhrase LIMIT 10
# columns: SearchPhrase
# output: [s,u]
# corgi orders strings shorter first, so ties break by length, then bytes.
let ranked = input map (s -> ((s len, 0u64) gt, (s, 1u64))) filter group
    map ((s, ones) -> ((18446744073709551615u64, ones len) sub, s)) sort_limit 10 in
ranked map ((d, s) -> (s, (18446744073709551615u64, d) sub))
