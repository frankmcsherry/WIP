# Q21: SELECT SearchPhrase, MIN(URL), COUNT(*) AS c FROM hits WHERE URL LIKE '%google%' AND SearchPhrase <> '' GROUP BY SearchPhrase ORDER BY c DESC LIMIT 10
# sql: SELECT SearchPhrase, min(URL), COUNT(*) AS c FROM hits
# sql:   WHERE decode(URL) LIKE '%google%' AND SearchPhrase <> '' GROUP BY SearchPhrase
# sql:   ORDER BY c DESC, SearchPhrase LIMIT 10
# columns: SearchPhrase URL
# output: [s,s,u]
# corgi has no substring search: a string contains "google" when, split at "e" (its last byte, which
# occurs once in it), some piece other than the last ends with "googl" (its last bytes read with
# gather_try, since a piece may be shorter).
let (phrase, url) = input in
let google = url map (u ->
    let pieces = u split "e" in
    let n = pieces len in
    let ends = pieces map (p ->
        let m = p len in
        let long = (m, 5) ge in
        let lo = (long, (m, 5) sub, 0) select in
        let tail = ((lo, (lo, 5) add) range, p) gather_try map (b -> b match (0 (x -> x), 1 (_ -> 0))) in
        (long, (tail, "googl") zip map ((a, c) -> (a, c) eq) fold_all) min) in
    (n, (n iota, ends) zip) cap_list map ((n, (i, e)) -> (((i, 1) add, n) lt, e) min) fold_any) in
let ranked = (phrase, (url, google) zip) zip map ((s, (u, g)) -> (((s len, 0) gt, g) min, (s, u))) filter group
    map ((s, us) -> (us len neg, s, us sort head)) sort_limit 10 in
ranked map ((d, s, u) -> (s, u, d neg))
    try match (0 (x -> x), 1 (_ -> 0 iota map (z -> ("", "", z))))
