# Q41: SELECT WindowClientWidth, WindowClientHeight, COUNT(*) AS PageViews FROM hits WHERE CounterID = 62 AND EventDate >= '2013-07-01' AND EventDate <= '2013-07-31' AND IsRefresh = 0 AND DontCountHits = 0 AND URLHash = 2868770270353813622 GROUP BY WindowClientWidth, WindowClientHeight ORDER BY PageViews DESC LIMIT 10 OFFSET 10000
# sql: SELECT WindowClientWidth, WindowClientHeight, COUNT(*) AS PageViews FROM hits WHERE CounterID = 62 AND EventDate >= 15887
# sql:   AND EventDate <= 15917 AND IsRefresh = 0 AND DontCountHits = 0 AND URLHash = 2868770270353813622
# sql:   GROUP BY WindowClientWidth, WindowClientHeight ORDER BY PageViews DESC, WindowClientWidth, WindowClientHeight LIMIT 10 OFFSET 10000
# columns: CounterID EventDate IsRefresh DontCountHits URLHash WindowClientWidth WindowClientHeight
# output: [u,u,u]
let (counter, date, refresh, dont, urlhash, width, height) = input in
let views = (counter, (date, (refresh, (dont, (urlhash, (width, height) zip) zip) zip) zip) zip) zip
    map ((c, (d, (r, (x, (h, (w, v)))))) ->
        ((((c, 62u64) eq, ((d, 15887u64) ge, (d, 15917u64) le) mul) mul,
          (((r, 0u64) eq, (x, 0u64) eq) mul, (h, 2868770270353813622i64) eq) mul) mul,
         ((w, v), 1u64))) filter in
let ranked = views group map (((w, v), ones) -> ((18446744073709551615u64, ones len) sub, w, v)) sort_limit 10010 in
((10000u64, (ranked len, 10010u64) min) range, ranked) gather
    try match (0 (top -> top map ((x, w, v) -> (w, v, (18446744073709551615u64, x) sub))), 1 (_ -> 0u64 iota map (z -> (z, z, z))))
