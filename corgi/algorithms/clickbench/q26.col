# Q26: SELECT SearchPhrase FROM hits WHERE SearchPhrase <> '' ORDER BY EventTime, SearchPhrase LIMIT 10
# sql: SELECT SearchPhrase FROM hits WHERE SearchPhrase <> '' ORDER BY EventTime, SearchPhrase LIMIT 10
# columns: EventTime SearchPhrase
# output: [s]
let (time, phrase) = input in
let sorted = (time, phrase) zip map ((t, s) -> ((s len, 0) gt, (t, s))) filter sort_limit 10 in
sorted map ((_, s) -> s)
