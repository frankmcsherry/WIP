# Q42: SELECT DATE_TRUNC('minute', EventTime) AS M, COUNT(*) AS PageViews FROM hits WHERE CounterID = 62 AND EventDate >= '2013-07-14' AND EventDate <= '2013-07-15' AND IsRefresh = 0 AND DontCountHits = 0 GROUP BY DATE_TRUNC('minute', EventTime) ORDER BY DATE_TRUNC('minute', EventTime) LIMIT 10 OFFSET 1000
# sql: SELECT EventTime // 60 * 60 AS M, COUNT(*) AS PageViews FROM hits WHERE CounterID = 62 AND EventDate >= 15900
# sql:   AND EventDate <= 15901 AND IsRefresh = 0 AND DontCountHits = 0 GROUP BY M ORDER BY M LIMIT 10 OFFSET 1000
# columns: CounterID EventDate IsRefresh DontCountHits EventTime
# output: [u,u]
# EventTime is Unix seconds, so the minute it falls in starts at t / 60 * 60.
let (counter, date, refresh, dont, time) = input in
let minutes = (counter, (date, (refresh, (dont, time) zip) zip) zip) zip
    map ((c, (d, (r, (x, t)))) ->
        ((((c, 62) eq, ((d, 15900) ge, (d, 15901) le) min) min, ((r, 0) eq, (x, 0) eq) min) min,
         (((t, 60) div, 60) mul, ()))) filter in
let counts = minutes group map ((m, rows) -> (m, rows len)) in
((1000, (counts len, 1010) min) range, counts) gather
