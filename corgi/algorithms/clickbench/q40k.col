# Q40: SELECT URLHash, EventDate, COUNT(*) AS PageViews FROM hits WHERE CounterID = 62 AND EventDate >= '2013-07-01' AND EventDate <= '2013-07-31' AND IsRefresh = 0 AND TraficSourceID IN (-1, 6) AND RefererHash = 3594120000172545465 GROUP BY URLHash, EventDate ORDER BY PageViews DESC LIMIT 10 OFFSET 100
# The variant with `sort_limit`: sorting only what can reach the limit.
# sql: SELECT URLHash, EventDate, COUNT(*) AS PageViews FROM hits WHERE CounterID = 62 AND EventDate >= 15887 AND EventDate <= 15917
# sql:   AND IsRefresh = 0 AND TraficSourceID IN (-1, 6) AND RefererHash = 3594120000172545465
# sql:   GROUP BY URLHash, EventDate ORDER BY PageViews DESC, URLHash, EventDate LIMIT 10 OFFSET 100
# columns: CounterID EventDate IsRefresh TraficSourceID RefererHash URLHash
# output: [i,u,u]
let (counter, date, refresh, source, refhash, urlhash) = input in
let views = (counter, (date, (refresh, (source, (refhash, urlhash) zip) zip) zip) zip) zip
    map ((c, (d, (r, (t, (f, h))))) ->
        ((((c, 62u64) eq, ((d, 15887u64) ge, (d, 15917u64) le) mul) mul,
          (((r, 0u64) eq, ((t, -1i64) eq, (t, 6i64) eq) max) mul, (f, 3594120000172545465i64) eq) mul) mul,
         ((h, d), 1u64))) filter in
let ranked = views group map (((h, d), ones) -> ((18446744073709551615u64, ones len) sub, h, d)) sort_limit 110 in
((100u64, (ranked len, 110u64) min) range, ranked) gather
    try match (0 (top -> top map ((x, h, d) -> (h, d, (18446744073709551615u64, x) sub))), 1 (_ -> 0u64 iota map (z -> (z, z, z))))
