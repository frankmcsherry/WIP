# Q34: SELECT 1, URL, COUNT(*) AS c FROM hits GROUP BY 1, URL ORDER BY c DESC LIMIT 10
# sql: SELECT 1, URL, COUNT(*) AS c FROM hits GROUP BY 1, URL ORDER BY c DESC, URL LIMIT 10
# columns: URL
# output: [u,s,u]
# GROUP BY 1, URL groups by URL alone: the 1 is the same in every row.
let ranked = input map (u -> (u, ())) hash_group map ((u, rows) -> (rows len neg, u)) sort_limit 10 in
ranked map ((d, u) -> (1, u clone, d neg))
