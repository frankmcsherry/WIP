# Q34: SELECT 1, URL, COUNT(*) AS c FROM hits GROUP BY 1, URL ORDER BY c DESC LIMIT 10
# sql: SELECT 1, URL, COUNT(*) AS c FROM hits GROUP BY 1, URL ORDER BY c DESC, URL LIMIT 10
# columns: URL
# output: [u,s,u]
let ranked = input map (u -> ((1u64, u), 1u64)) group map (((one, u), ones) -> ((18446744073709551615u64, ones len) sub, one, u)) sort_limit 10 in
ranked map ((d, one, u) -> (one, u, (18446744073709551615u64, d) sub))
