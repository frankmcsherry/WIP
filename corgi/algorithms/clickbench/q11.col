# Q11: SELECT MobilePhone, MobilePhoneModel, COUNT(DISTINCT UserID) AS u FROM hits WHERE MobilePhoneModel <> '' GROUP BY MobilePhone, MobilePhoneModel ORDER BY u DESC LIMIT 10
# sql: SELECT MobilePhone, MobilePhoneModel, COUNT(DISTINCT UserID) AS u FROM hits WHERE MobilePhoneModel <> ''
# sql:   GROUP BY MobilePhone, MobilePhoneModel ORDER BY u DESC, MobilePhone, MobilePhoneModel LIMIT 10
# columns: MobilePhone MobilePhoneModel UserID
# output: [u,s,u]
let (phone, model, user) = input in
let ranked = (phone, (model, user) zip) zip map ((p, (m, u)) -> ((m len, 0) gt, ((p, m), u))) filter group
    map (((p, m), us) -> (us dedup len neg, p, m)) sort_limit 10 in
ranked map ((d, p, m) -> (p, m, d neg))
    try match (0 (x -> x), 1 (_ -> 0 iota map (z -> (z, "", z))))
