# Q36: SELECT URL, COUNT(*) AS PageViews FROM hits WHERE CounterID = 62 AND EventDate >= '2013-07-01' AND EventDate <= '2013-07-31' AND DontCountHits = 0 AND IsRefresh = 0 AND URL <> '' GROUP BY URL ORDER BY PageViews DESC LIMIT 10
# sql: SELECT URL, COUNT(*) AS PageViews FROM hits WHERE CounterID = 62 AND EventDate >= 15887 AND EventDate <= 15917
# sql:   AND DontCountHits = 0 AND IsRefresh = 0 AND URL <> '' GROUP BY URL
# sql:   ORDER BY PageViews DESC, URL LIMIT 10
# columns: CounterID EventDate DontCountHits IsRefresh URL
# output: [s,u]
let views = input zip map ((c, d, x, r, k) ->
    (((c, 62) eq, (d, 15887) ge, (d, 15917) le, (x, 0) eq, (r, 0) eq, (k len, 0) gt) all, (k ref, ()))) filter in
let ranked = views hash_group map ((k, rows) -> (rows len neg, k)) sort_limit 10 in
ranked map ((d, k) -> (k clone, d neg))
