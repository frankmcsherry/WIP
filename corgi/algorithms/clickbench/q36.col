# Q36: SELECT URL, COUNT(*) AS PageViews FROM hits WHERE CounterID = 62 AND EventDate >= '2013-07-01' AND EventDate <= '2013-07-31' AND DontCountHits = 0 AND IsRefresh = 0 AND URL <> '' GROUP BY URL ORDER BY PageViews DESC LIMIT 10
# sql: SELECT URL, COUNT(*) AS PageViews FROM hits WHERE CounterID = 62 AND EventDate >= 15887 AND EventDate <= 15917
# sql:   AND DontCountHits = 0 AND IsRefresh = 0 AND URL <> '' GROUP BY URL
# sql:   ORDER BY PageViews DESC, URL LIMIT 10
# columns: CounterID EventDate DontCountHits IsRefresh URL
# output: [s,u]
# Grouped by hash, each key carried by reference. A hash group holds one key unless two keys share
# a hash; its runs of equal keys (`adjacent`) say so, and if any group holds two the query runs
# grouped by key instead.
let (counter, date, dont, refresh, key) = input in
let views = (counter, (date, (dont, (refresh, key) zip) zip) zip) zip
    map ((c, (d, (x, (r, k)))) ->
        ((((c, 62) eq, ((d, 15887) ge, (d, 15917) le) min) min,
          (((x, 0) eq, (r, 0) eq) min, (k len, 0) gt) min) min, (k hash, k ref))) filter in
let groups = views group in
let collided = (groups map ((h, ks) -> ks adjacent fold_add) fold_max, 1) gt in
((groups, input), collided) branch 2 match (
    0 ((groups, _) -> groups map ((h, ks) -> (ks len neg, (0, ks) get)) sort_limit 10
        map ((d, k) -> (k clone, d neg))),
    1 ((_, (counter, date, dont, refresh, key)) ->
        (counter, (date, (dont, (refresh, key) zip) zip) zip) zip
        map ((c, (d, (x, (r, k)))) ->
            ((((c, 62) eq, ((d, 15887) ge, (d, 15917) le) min) min,
              (((x, 0) eq, (r, 0) eq) min, (k len, 0) gt) min) min, (k, ()))) filter
        group map ((k, rows) -> (rows len neg, k)) sort_limit 10 map ((d, k) -> (k, d neg))))
