# Q9: SELECT RegionID, SUM(AdvEngineID), COUNT(*) AS c, AVG(ResolutionWidth), COUNT(DISTINCT UserID) FROM hits GROUP BY RegionID ORDER BY c DESC LIMIT 10
# sql: SELECT RegionID, SUM(AdvEngineID), COUNT(*) AS c, AVG(ResolutionWidth), COUNT(DISTINCT UserID) FROM hits
# sql:   GROUP BY RegionID ORDER BY c DESC, RegionID LIMIT 10
# columns: RegionID AdvEngineID ResolutionWidth UserID
# output: [u,u,u,f,u]
let (region, adv, width, user) = input in
# The count and sums by region; each distinct (region, user) once, then the users counted by region.
# Both sorted by region, so they pair up.
let sums = (region, (adv, width) zip map ((a, w) -> (1, a, w))) scatter_add sort in
let pairs = ((region, user) zip, region map (_ -> 1)) scatter_add in
let users = pairs map (((r, _), _) -> (r, 1)) transpose scatter_add sort in
let ranked = (sums, users) zip map (((r, (n, a, w)), (_, u)) ->
    (n neg, r, a, n, (w to_float, n to_float) div, u)) sort_limit 10 in
ranked map ((_, r, a, c, w, u) -> (r, a, c, w, u))
