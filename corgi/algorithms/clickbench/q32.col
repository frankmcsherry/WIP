# Q32: SELECT WatchID, ClientIP, COUNT(*) AS c, SUM(IsRefresh), AVG(ResolutionWidth) FROM hits GROUP BY WatchID, ClientIP ORDER BY c DESC LIMIT 10
# sql: SELECT WatchID, ClientIP, COUNT(*) AS c, SUM(IsRefresh), AVG(ResolutionWidth) FROM hits 
# sql:   GROUP BY WatchID, ClientIP ORDER BY c DESC, WatchID, ClientIP LIMIT 10
# columns: WatchID ClientIP IsRefresh ResolutionWidth
# output: [i,i,u,u,f]
let (watchid, ip, refresh, width) = input in
let rows = (watchid, (ip, (refresh, width) zip) zip) zip map ((e, (i, (r, w))) -> ((e, i), (r, w))) in
let ranked = rows group map (((e, i), vs) -> let n = vs len in
    (n neg, e, i, n, vs map ((r, _) -> r) fold_add, (vs map ((_, w) -> w) fold_add to_float, n to_float) div)) sort_limit 10 in
ranked map ((_, e, i, n, r, w) -> (e, i, n, r, w))
