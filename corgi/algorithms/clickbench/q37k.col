# Q37: SELECT Title, COUNT(*) AS PageViews FROM hits WHERE CounterID = 62 AND EventDate >= '2013-07-01' AND EventDate <= '2013-07-31' AND DontCountHits = 0 AND IsRefresh = 0 AND Title <> '' GROUP BY Title ORDER BY PageViews DESC LIMIT 10
# The variant with `sort_limit`: sorting only what can reach the limit.
# sql: SELECT Title, COUNT(*) AS PageViews FROM hits WHERE CounterID = 62 AND EventDate >= 15887 AND EventDate <= 15917
# sql:   AND DontCountHits = 0 AND IsRefresh = 0 AND Title <> '' GROUP BY Title
# sql:   ORDER BY PageViews DESC, octet_length(Title), Title LIMIT 10
# columns: CounterID EventDate DontCountHits IsRefresh Title
# output: [s,u]
let (counter, date, dont, refresh, key) = input in
let views = (counter, (date, (dont, (refresh, key) zip) zip) zip) zip
    map ((c, (d, (x, (r, k)))) ->
        ((((c, 62u64) eq, ((d, 15887u64) ge, (d, 15917u64) le) mul) mul,
          (((x, 0u64) eq, (r, 0u64) eq) mul, (k len, 0u64) gt) mul) mul, (k, 1u64))) filter in
let ranked = views group map ((k, ones) -> ((18446744073709551615u64, ones len) sub, k)) sort_limit 10 in
ranked map ((d, k) -> (k, (18446744073709551615u64, d) sub))
    try match (0 (x -> x), 1 (_ -> 0u64 iota map (z -> ("", z))))
