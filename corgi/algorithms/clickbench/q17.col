# Q17: SELECT UserID, SearchPhrase, COUNT(*) FROM hits GROUP BY UserID, SearchPhrase LIMIT 10
# sql: SELECT UserID, SearchPhrase, COUNT(*) FROM hits GROUP BY UserID, SearchPhrase
# sql:   ORDER BY UserID, SearchPhrase LIMIT 10
# columns: UserID SearchPhrase
# output: [i,s,u]
# Without ORDER BY the SQL's ten rows are any ten; corgi's groups come out in key order, so the
# deterministic version takes the first ten keys.
let (user, phrase) = input in
let groups = (user, phrase) zip map ((u, s) -> ((u, s), ())) group map (((u, s), rows) -> (u, s, rows len)) in
((0, (groups len, 10) min) range, groups) gather
