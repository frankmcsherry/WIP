# Q28: SELECT REGEXP_REPLACE(Referer, '^https?://(?:www\.)?([^/]+)/.*$', '\1') AS k, AVG(STRLEN(Referer)) AS l, COUNT(*) AS c, MIN(Referer) FROM hits WHERE Referer <> '' GROUP BY k HAVING COUNT(*) > 100000 ORDER BY l DESC LIMIT 25
# sql: SELECT regexp_replace(decode(Referer), '^https?://(?:www\.)?([^/]+)/.*$', '\1') AS k, AVG(octet_length(Referer)) AS l,
# sql:   COUNT(*) AS c, min(Referer) FROM hits WHERE Referer <> ''
# sql:   GROUP BY k HAVING COUNT(*) > 1000 ORDER BY l DESC, k LIMIT 25
# columns: Referer
# output: [s,f,u,s]
# corgi has no regular expressions; this is the regexp as byte logic. A referer matches when it starts
# with "http://" or "https://", then (optionally "www.") at least one byte before a '/', with no
# newline after that '/' (RE2's '.' doesn't match '\n'); the key is the bytes between. When "www."
# would leave no byte before the '/', RE2 matches without it, so the key is "www.". No match: the
# referer itself. HAVING scaled to 1/100. MIN is the first in corgi's string order.
let refs = input map (r -> ((r len, 0) gt, r)) filter in
let keyed = refs map (r ->
    let n = r len in
    let http = (((0, (0, 7) add) range, r) gather, "http://") zip map ((a, c) -> (a, c) eq) fold_all in
    let https = (((0, (0, 8) add) range, r) gather, "https://") zip map ((a, c) -> (a, c) eq) fold_all in
    let at = (https, 8, (http, 7, 0) select) select in
    let www = (((at, (at, 4) add) range, r) gather, "www.") zip map ((a, c) -> (a, c) eq) fold_all in
    let slashes = (n iota, r) zip map ((i, c) -> ((c, 47) eq, i)) filter in
    let newlines = (n iota, r) zip map ((i, c) -> ((c, 10) eq, i)) filter in
    # the first '/' at or after a position: the least slash not before it (the largest Int if none)
    let none = (slashes len, 0) eq in
    let after_www = (none, 9223372036854775807, ((at, 4) add, slashes) cap_list map ((p, s) -> ((s, p) ge, s, 9223372036854775807) select) fold_min) select in
    let after_at = (none, 9223372036854775807, (at, slashes) cap_list map ((p, s) -> ((s, p) ge, s, 9223372036854775807) select) fold_min) select in
    let with_www = (www, (after_www, (at, 4) add) gt) min in
    let start = (with_www, (at, 4) add, at) select in
    let end = (with_www, after_www, after_at) select in
    let found = (((http, https) max, (end, 9223372036854775807) lt) min, (end, start) gt) min in
    let late_newline = (end, newlines) cap_list map ((e, q) -> (q, e) gt) fold_any in
    let matched = (found, (late_newline, 0) eq) min in
    let lo = (matched, start, 0) select in
    let hi = (matched, end, 0) select in
    let domain = ((lo, hi) range, r) gather in
    ((matched, domain, r) select, r)) in
let ranked = keyed group
    map ((k, rs) -> let c = rs len in
        ((c, 1000) gt, (k, (rs map (r -> r len) fold_add to_float, c to_float) div, c, rs sort head))) filter
    map ((k, l, c, m) -> (l neg, k, l, c, m)) sort_limit 25 in
ranked map ((_, k, l, c, m) -> (k, l, c, m))
