# Q28: SELECT REGEXP_REPLACE(Referer, '^https?://(?:www\.)?([^/]+)/.*$', '\1') AS k, AVG(STRLEN(Referer)) AS l, COUNT(*) AS c, MIN(Referer) FROM hits WHERE Referer <> '' GROUP BY k HAVING COUNT(*) > 100000 ORDER BY l DESC LIMIT 25
# sql: SELECT regexp_replace(decode(Referer), '^https?://(?:www\.)?([^/]+)/.*$', '\1') AS k, AVG(octet_length(Referer)) AS l,
# sql:   COUNT(*) AS c, arg_min(Referer, {'l': octet_length(Referer), 'r': Referer}) FROM hits WHERE Referer <> ''
# sql:   GROUP BY k HAVING COUNT(*) > 1000 ORDER BY l DESC, strlen(k), k LIMIT 25
# columns: Referer
# output: [s,f,u,s]
# corgi has no regular expressions; this is the regexp as byte logic. A referer matches when it starts
# with "http://" or "https://", then (optionally "www.") at least one byte before a '/', with no
# newline after that '/' (RE2's '.' doesn't match '\n'); the key is the bytes between. When "www."
# would leave no byte before the '/', RE2 matches without it, so the key is "www.". No match: the
# referer itself. HAVING scaled to 1/100. MIN is the first in corgi's string order.
let refs = input map (r -> ((r len, 0u64) gt, r)) filter in
let keyed = refs map (r ->
    let n = r len in
    let http = (((0u64, (0u64, 7u64) add) range, r) gather_try map (b -> b match (0 (x -> x), 1 (_ -> 0u8))), "http://") zip map ((a, c) -> (a, c) eq) fold_all in
    let https = (((0u64, (0u64, 8u64) add) range, r) gather_try map (b -> b match (0 (x -> x), 1 (_ -> 0u8))), "https://") zip map ((a, c) -> (a, c) eq) fold_all in
    let at = (https, 8u64, (http, 7u64, 0u64) select) select in
    let www = (((at, (at, 4u64) add) range, r) gather_try map (b -> b match (0 (x -> x), 1 (_ -> 0u8))), "www.") zip map ((a, c) -> (a, c) eq) fold_all in
    let slashes = (n iota, r) zip map ((i, c) -> ((c, 47u8) eq, i)) filter in
    let newlines = (n iota, r) zip map ((i, c) -> ((c, 10u8) eq, i)) filter in
    # the first '/' at or after a position: the least slash not before it (MAX if none)
    let after_www = ((at, 4u64) add, slashes) cap_list map ((p, s) -> ((s, p) ge, s, 18446744073709551615u64) select) fold_min in
    let after_at = (at, slashes) cap_list map ((p, s) -> ((s, p) ge, s, 18446744073709551615u64) select) fold_min in
    let with_www = (www, (after_www, (at, 4u64) add) gt) mul in
    let start = (with_www, (at, 4u64) add, at) select in
    let end = (with_www, after_www, after_at) select in
    let found = (((http, https) max, (end, 18446744073709551615u64) lt) mul, (end, start) gt) mul in
    let late_newline = (end, newlines) cap_list map ((e, q) -> (q, e) gt) fold_any in
    let matched = (found, (late_newline, 0u64) eq) mul in
    let lo = (matched, start, 0u64) select in
    let hi = (matched, end, 0u64) select in
    let domain = ((lo, hi) range, r) gather in
    ((matched, domain, r) select, r)) in
let ranked = keyed group
    map ((k, rs) -> let c = rs len in
        ((c, 1000u64) gt, (k, (rs map (r -> r len) fold_add to_f64, c to_f64) div_f64, c, rs sort head))) filter
    map ((k, l, c, m) -> ((18446744073709551615u64, l) sub, k, l, c, m)) sort_limit 25 in
ranked map ((_, k, l, c, m) -> (k, l, c, m))
    try match (0 (x -> x), 1 (_ -> 0u64 iota map (z -> ("", 0f64, z, ""))))
