# Q30: SELECT SearchEngineID, ClientIP, COUNT(*) AS c, SUM(IsRefresh), AVG(ResolutionWidth) FROM hits WHERE SearchPhrase <> '' GROUP BY SearchEngineID, ClientIP ORDER BY c DESC LIMIT 10
# sql: SELECT SearchEngineID, ClientIP, COUNT(*) AS c, SUM(IsRefresh), AVG(ResolutionWidth) FROM hits WHERE SearchPhrase <> '' 
# sql:   GROUP BY SearchEngineID, ClientIP ORDER BY c DESC, SearchEngineID, ClientIP LIMIT 10
# columns: SearchEngineID ClientIP IsRefresh ResolutionWidth SearchPhrase
# output: [u,i,u,u,f]
let (searchengineid, ip, refresh, width, phrase) = input in
let rows = (searchengineid, (ip, (refresh, (width, phrase) zip) zip) zip) zip
    map ((e, (i, (r, (w, s)))) -> ((s len, 0) gt, ((e, i), (r, w)))) filter in
let ranked = rows group map (((e, i), vs) -> let n = vs len in
    (n neg, e, i, n, vs map ((r, _) -> r) fold_add, (vs map ((_, w) -> w) fold_add to_float, n to_float) div)) sort_limit 10 in
ranked map ((_, e, i, n, r, w) -> (e, i, n, r, w))
    try match (0 (x -> x), 1 (_ -> 0 iota map (z -> (z, z, z, z, 0.0))))
