# Q38: SELECT URL, COUNT(*) AS PageViews FROM hits WHERE CounterID = 62 AND EventDate >= '2013-07-01' AND EventDate <= '2013-07-31' AND IsRefresh = 0 AND IsLink <> 0 AND IsDownload = 0 GROUP BY URL ORDER BY PageViews DESC LIMIT 10 OFFSET 1000
# sql: SELECT URL, COUNT(*) AS PageViews FROM hits WHERE CounterID = 62 AND EventDate >= 15887 AND EventDate <= 15917
# sql:   AND IsRefresh = 0 AND IsLink <> 0 AND IsDownload = 0 GROUP BY URL
# sql:   ORDER BY PageViews DESC, URL LIMIT 10 OFFSET 1000
# columns: CounterID EventDate IsRefresh IsLink IsDownload URL
# output: [s,u]
let views = input zip map ((c, d, r, l, w, u) ->
    (((c, 62) eq, (d, 15887) ge, (d, 15917) le, (r, 0) eq, (l, 0) ne, (w, 0) eq) all, (u ref, ()))) filter in
let ranked = views hash_group map ((u, rows) -> (rows len neg, u)) sort_limit 1010 in
((1000, (ranked len, 1010) min) range, ranked) gather
    map ((d, u) -> (u clone, d neg))
