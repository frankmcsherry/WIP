# substring_count with the text captured by reference: each start gets a reference to its row's
# text instead of a copy of it, and the window gather reads through the reference.
let (text, pat) = input in
let (n, m) = (text len, pat len) in
# every start i with i + m <= n.
let starts = ((((n, 1) add, m) max, m) sub) iota in
((text ref, pat), starts) cap_list map (((text, pat), i) ->
    let w = ((i, (i, pat len) add) range, text) gather in
    (w, pat) zip map ((a, b) -> (a, b) eq) fold_all) fold_add
    try match (0 (c -> c), 1 (_ -> 0))
